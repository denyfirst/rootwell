# Only the application source and explicitly public demo assets enter the build.
**
!go.mod
!go.sum
!cmd/
!cmd/**/
!cmd/**/*.go
!cmd/rootwelld/auth/*.html
!cmd/rootwelld/auth/*.css
!cmd/rootwelld/auth/*.js
# Exact generated, public-only website examples; never arbitrary JSON data.
!cmd/rootwelld/auth/website-examples.json
!internal/
!internal/**/
!internal/**/*.go
!web/
!web/workbench/
!web/workbench/index.html
!web/workbench/app.js
!web/workbench/theme.js
!web/workbench/wasm-loader.js
!web/workbench/style.css
!web/workbench/favicon.svg
!web/workbench/rootwell-demo-certificate.pem
!web/workbench/rootwell-demo-bundle.pem
!web/workbench/rootwell-verify-demo-root.pem
!web/workbench/rootwell-verify-demo-leaf.pem
!web/workbench/rootwell-verify-demo-intermediate.pem
!web/workbench/rootwell-verify-demo-ca-files.pem
**/*.pem
# Exact public-only embedded staging roots; never private/operator PEM files.
!internal/acmecertificate/staging-roots.pem
# Separate exact public-only production receipt asset; never operator material.
!internal/acmecertificate/production-roots.pem
!web/workbench/rootwell-demo-certificate.pem
!web/workbench/rootwell-demo-bundle.pem
!web/workbench/rootwell-verify-demo-root.pem
!web/workbench/rootwell-verify-demo-leaf.pem
!web/workbench/rootwell-verify-demo-intermediate.pem
!web/workbench/rootwell-verify-demo-ca-files.pem
